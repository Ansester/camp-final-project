    "mongoose": "^9.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "c8": "^9.1.0",
    "chai": "^4.3.10",
    "mocha": "^12.0.3",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
