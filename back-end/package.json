{
  "name": "camp-backend",
  "version": "1.0.0",
  "description": "Coursework campus equipment API with MongoDB and JWT authentication",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
